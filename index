  <!-- Snackbar 通知用 -->
  <div id="snackbar">追加しました</div>

  <script>
    // ==================== エモジ浮遊アニメーション ====================
    const EMOJI_CONFIG = {
      emojis: ['✨', '🌟', '🍵', '🍃', '⏱️', '😊', '🌸', '💡', '🍀', '🎉'],
      count: 2,
      duration: 3000,
      speedX: 1.5,
      speedY: 2.5,
      size: 24
    };

    function popEmojis(x, y) {
      const container = document.getElementById('emoji-container');
      const count = Math.floor(Math.random() * EMOJI_CONFIG.count) + 1;

      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'floating-emoji';
        
        const emoji = EMOJI_CONFIG.emojis[Math.floor(Math.random() * EMOJI_CONFIG.emojis.length)];
        el.textContent = emoji;
        
        const baseSize = EMOJI_CONFIG.size + Math.random() * 12 - 6;
        el.style.fontSize = `${baseSize}px`;
        el.style.left = `${x - baseSize/2}px`;
        el.style.top = `${y - baseSize}px`;
        
        container.appendChild(el);

        const dirX = (Math.random() - 0.5) * EMOJI_CONFIG.speedX * 2;
        const dirY = -Math.random() * EMOJI_CONFIG.speedY - 1.5;
        
        let startTime = performance.now();
        const phase = Math.random() * Math.PI * 2;

        requestAnimationFrame(() => {
          el.style.opacity = '1';
        });

        function animate(now) {
          const elapsed = now - startTime;
          if (elapsed >= EMOJI_CONFIG.duration) {
            el.remove();
            return;
          }

          const progress = elapsed / EMOJI_CONFIG.duration;
          const currentX = dirX * elapsed * 0.06 + Math.sin(progress * Math.PI * 3 + phase) * 8;
          const currentY = dirY * elapsed * 0.06;

          let currentOpacity = 1;
          if (progress > 0.6) {
            currentOpacity = 1 - ((progress - 0.6) / 0.4);
          }

          const scale = 1 - progress * 0.4;

          el.style.transform = `translate(${currentX}px, ${currentY}px) scale(${scale}) rotate(${dirX * 15}deg)`;
          el.style.opacity = currentOpacity;

          requestAnimationFrame(animate);
        }

        requestAnimationFrame(animate);
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target.closest('.btn, .nav-item, .icon-btn, .chart-toggle-btn');
      if (target) {
        const rect = target.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        popEmojis(centerX, centerY);
      }
    });


    // ==================== アプリケーションロジック ====================
    (function() {
      let snackbarTimeout;
      function showSnackbar(message) {
        const sb = document.getElementById('snackbar');
        sb.textContent = message;
        sb.className = 'show';
        clearTimeout(snackbarTimeout);
        snackbarTimeout = setTimeout(() => { sb.className = sb.className.replace('show', ''); }, 3000);
      }

      // ===== IndexedDB =====
      const DB_NAME = 'AttendanceDB';
      const DB_VERSION = 1;
      const STORE_NAME = 'records';
      let db = null;

      function openDB() {
        return new Promise((resolve, reject) => {
          const request = indexedDB.open(DB_NAME, DB_VERSION);
          request.onerror = (e) => { console.error('IndexedDB 接続エラー:', e.target.error); reject(e.target.error); };
          request.onsuccess = (e) => { db = e.target.result; resolve(db); };
          request.onupgradeneeded = (e) => {
            const db = e.target.result;
            if (!db.objectStoreNames.contains(STORE_NAME)) {
              db.createObjectStore(STORE_NAME, { keyPath: 'id', autoIncrement: true });
            }
          };
        });
      }

      function loadAllRecords() {
        return new Promise((resolve, reject) => {
          if (!db) { reject(new Error('DB not initialized')); return; }
          const tx = db.transaction(STORE_NAME, 'readonly');
          const store = tx.objectStore(STORE_NAME);
          const request = store.getAll();
          request.onsuccess = () => resolve(request.result);
          request.onerror = () => reject(request.error);
        });
      }

      function saveRecord(record) {
        return new Promise((resolve, reject) => {
          if (!db) { reject(new Error('DB not initialized')); return; }
          const tx = db.transaction(STORE_NAME, 'readwrite');
          const store = tx.objectStore(STORE_NAME);
          const request = store.put(record);
          request.onsuccess = () => resolve(request.result);
          request.onerror = () => reject(request.error);
        });
      }

      function deleteRecord(id) {
        return new Promise((resolve, reject) => {
          if (!db) { reject(new Error('DB not initialized')); return; }
          const tx = db.transaction(STORE_NAME, 'readwrite');
          const store = tx.objectStore(STORE_NAME);
          const request = store.delete(id);
          request.onsuccess = () => resolve();
          request.onerror = () => reject(request.error);
        });
      }

      function clearAllRecords() {
        return new Promise((resolve, reject) => {
          if (!db) { reject(new Error('DB not initialized')); return; }
          const tx = db.transaction(STORE_NAME, 'readwrite');
          const store = tx.objectStore(STORE_NAME);
          const request = store.clear();
          request.onsuccess = () => resolve();
          request.onerror = () => reject(request.error);
        });
      }

      function bulkSaveRecords(recordsArray) {
        return new Promise((resolve, reject) => {
          if (!db) { reject(new Error('DB not initialized')); return; }
          const tx = db.transaction(STORE_NAME, 'readwrite');
          const store = tx.objectStore(STORE_NAME);

          tx.oncomplete = () => resolve();
          tx.onerror = () => reject(tx.error);

          const clearRequest = store.clear();
          clearRequest.onsuccess = () => {
            recordsArray.forEach(rec => {
              const { id, ...rest } = rec;
              store.add(rest);
            });
          };
        });
      }

      // ===== ユーティリティ =====
      function parseTimeToDecimal(timeStr) {
        if (!timeStr) return 0;
        const parts = timeStr.split(':');
        if (parts.length < 2) return 0;
        const hours = parseInt(parts[0], 10);
        const minutes = parseInt(parts[1], 10);
        const seconds = parts[2] ? parseInt(parts[2], 10) : 0;
        return hours + minutes / 60 + seconds / 3600;
      }

      function calcWorkHours(startStr, endStr) {
        if (!startStr || !endStr) return 0;
        const start = parseTimeToDecimal(startStr);
        const end = parseTimeToDecimal(endStr);
        if (end <= start) return 0;
        return Math.max(0, end - start);
      }

      function calcOvertime(startStr, endStr, isHoliday) {
        const work = calcWorkHours(startStr, endStr);
        if (isHoliday) return work;
        return Math.max(0, work - 9);
      }

      function normalizeTimeInput(timeStr) {
        if (!timeStr) return '';
        const match = timeStr.match(/^(\d{1,2}:\d{2})(?::(\d{1,2}))?/);
        if (match) {
          const base = match[1];
          const sec = match[2] ? match[2].padStart(2, '0') : '00';
          return `${base}:${sec}`;
        }
        return timeStr;
      }

      function timeInputToFullStr(timeInputValue) {
        if (!timeInputValue) return '';
        if (timeInputValue.includes(':')) {
          const parts = timeInputValue.split(':');
          if (parts.length === 2) return timeInputValue + ':00';
          if (parts.length >= 3) return parts[0] + ':' + parts[1] + ':' + (parts[2] ? parts[2].slice(0,2) : '00');
        }
        return timeInputValue + ':00';
      }

      function formatDateToYMD(date) {
        const y = date.getFullYear();
        const m = String(date.getMonth() + 1).padStart(2, '0');
        const d = String(date.getDate()).padStart(2, '0');
        return `${y}-${m}-${d}`;
      }

      function getCurrentYearMonth() {
        const now = new Date();
        return `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}`;
      }

      // ===== 状態 =====
      let records = [];
      let currentMonth = '';
      let chartMonth = '';
      let chartMode = 'month';
      let editingId = null;
      let editBuffer = null;
      let chartInstance = null;

      const tableBody = document.getElementById('tableBody');
      const summaryRow = document.getElementById('summaryRow');
      const monthSelect = document.getElementById('monthSelect');
      const chartMonthSelect = document.getElementById('chartMonthSelect');
      const chartMonthFilter = document.getElementById('chartMonthFilter');
      const chartCanvas = document.getElementById('overtimeChart');
      const navItems = document.querySelectorAll('.nav-item');
      const viewSections = document.querySelectorAll('.view-section');
      const loadingOverlay = document.getElementById('loadingOverlay');
      const toggleBtns = document.querySelectorAll('.chart-toggle-btn');
      
      const statYear = document.getElementById('statYear');
      const yearlyTotalOvertime = document.getElementById('yearlyTotalOvertime');

      const inputDate = document.getElementById('inputDate');
      const inputStart = document.getElementById('inputStart');
      const inputEnd = document.getElementById('inputEnd');
      const inputDailyOvertime = document.getElementById('inputDailyOvertime');
      const inputIsHoliday = document.getElementById('inputIsHoliday');
      const addRecordBtn = document.getElementById('addRecordBtn');

      const importFileInput = document.getElementById('importFileInput');
      const importBtn = document.getElementById('importBtn');
      const exportBtn = document.getElementById('exportBtn');
      const resetBtn = document.getElementById('resetBtn');

      // ===== 导航平滑移动 =====
      const navList = document.getElementById('navList');
      const navCapsule = document.getElementById('navCapsule');
      
      function initCapsule() {
        const activeItem = navList.querySelector('.nav-item.active');
        if(activeItem) {
          navCapsule.style.height = `${activeItem.offsetHeight}px`;
          navCapsule.style.transition = 'none';
          navCapsule.style.transform = `translateY(${activeItem.offsetTop}px)`;
          requestAnimationFrame(() => {
            navCapsule.style.transition = 'transform 0.4s cubic-bezier(0.25, 1, 0.5, 1)';
          });
        }
      }
      setTimeout(initCapsule, 100);

      navItems.forEach(item => {
        item.addEventListener('click', () => {
          if (item.classList.contains('active')) return;
          
          navItems.forEach(i => i.classList.remove('active'));
          item.classList.add('active');

          navCapsule.style.transform = `translateY(${item.offsetTop}px)`;

          const targetView = item.getAttribute('data-view');
          switchView(targetView);
        });
      });

      // ===== 月関連 =====
      function getAllMonths() {
        const monthSet = new Set();
        records.forEach(r => { if (r.date) monthSet.add(r.date.slice(0, 7)); });
        return Array.from(monthSet).sort();
      }

      function initDefaultMonth() {
        const now = new Date();
        const currentYM = getCurrentYearMonth();
        const months = getAllMonths();
        if (months.includes(currentYM)) {
          currentMonth = currentYM;
        } else if (months.length > 0) {
          currentMonth = months[months.length - 1];
        } else {
          currentMonth = currentYM;
        }
        chartMonth = currentMonth;
      }

      function populateMonthSelects() {
        const months = getAllMonths();
        if (months.length === 0) {
          monthSelect.innerHTML = '<option value="">データなし</option>';
          chartMonthSelect.innerHTML = '<option value="">データなし</option>';
          return;
        }
        if (!months.includes(currentMonth)) currentMonth = months[months.length - 1];
        if (!months.includes(chartMonth)) chartMonth = months[months.length - 1];

        monthSelect.innerHTML = months.map(m => {
          const label = m.replace('-', '年') + '月';
          return `<option value="${m}" ${m === currentMonth ? 'selected' : ''}>${label}</option>`;
        }).join('');

        chartMonthSelect.innerHTML = months.map(m => {
          const label = m.replace('-', '年') + '月';
          return `<option value="${m}" ${m === chartMonth ? 'selected' : ''}>${label}</option>`;
        }).join('');
      }

      // ===== 描画関連 =====
      function getFilteredRecords() {
        if (!currentMonth) return [];
        const thisMonth = getCurrentYearMonth();
        const isCurrentMonth = currentMonth === thisMonth;
        const filtered = records
          .map(r => ({ ...r }))
          .filter(r => r.date.startsWith(currentMonth));
        if (isCurrentMonth) {
          return filtered.sort((a, b) => new Date(b.date) - new Date(a.date));
        } else {
          return filtered.sort((a, b) => new Date(a.date) - new Date(b.date));
        }
      }

      function renderTable() {
        const filtered = getFilteredRecords();
        if (filtered.length === 0) {
          tableBody.innerHTML = `<tr><td colspan="7" class="empty-message">この月の勤怠データはありません</td></tr>`;
          updateSummary();
          return;
        }

        let html = '';
        filtered.forEach((r) => {
          const isEditing = editingId === r.id && editBuffer !== null;

          if (isEditing) {
            html += `<tr data-id="${r.id}">
              <td><input type="date" class="td-input" id="edit-date" value="${editBuffer.date}"></td>
              <td><input type="time" step="1" class="td-input" id="edit-start" value="${editBuffer.start || ''}"></td>
              <td><input type="time" step="1" class="td-input" id="edit-end" value="${editBuffer.end || ''}"></td>
              <td>—</td>
              <td>—</td>
              <td><input type="number" step="0.1" class="td-input number" id="edit-dailyOvertime" value="${editBuffer.dailyOvertime !== null && editBuffer.dailyOvertime !== undefined ? editBuffer.dailyOvertime : ''}"></td>
              <td>
                <label class="edit-checkbox-container">
                  <input type="checkbox" id="edit-isHoliday" ${editBuffer.isHoliday ? 'checked' : ''}>
                  <div class="checkbox-box">
                    <svg viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  </div>
                  休日
                </label>
              </td>
              <td>
                <div class="action-btns">
                  <button class="icon-btn save" data-action="save" data-id="${r.id}" title="保存">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                  </button>
                  <button class="icon-btn cancel" data-action="cancel" data-id="${r.id}" title="キャンセル">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                  </button>
                </div>
              </td>
            </tr>`;
          } else {
            const displayOvertime = r.dailyOvertime !== null && r.dailyOvertime !== undefined ? r.dailyOvertime.toFixed(1) : '—';
            const isMissingEnd = !r.end;
            const workHours = calcWorkHours(r.start, r.end);
            const overtime = calcOvertime(r.start, r.end, r.isHoliday);
            const rowClass = r.isHoliday ? 'class="holiday-row"' : '';

            html += `<tr data-id="${r.id}" ${rowClass}>
              <td>${r.date}</td>
              <td>${r.start || '—'}</td>
              <td style="${isMissingEnd ? 'color: var(--md-sys-color-error);' : ''}">${r.end || '未入力'}</td>
              <td>${workHours.toFixed(2)}</td>
              <td>${overtime.toFixed(2)}</td>
              <td>${displayOvertime}</td>
              <td>
                <div class="action-btns">
                  <button class="icon-btn edit" data-action="edit" data-id="${r.id}" title="編集">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                  </button>
                  <button class="icon-btn delete" data-action="delete" data-id="${r.id}" title="削除">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/></svg>
                  </button>
                </div>
              </td>
            </tr>`;
          }
        });

        tableBody.innerHTML = html;

        tableBody.querySelectorAll('[data-action]').forEach(btn => {
          btn.addEventListener('click', handleTableAction);
        });

        updateSummary();
      }

      async function handleTableAction(e) {
        const btn = e.currentTarget;
        const action = btn.getAttribute('data-action');
        const id = parseInt(btn.getAttribute('data-id'), 10);
        if (isNaN(id)) return;

        if (action === 'edit') {
          const rec = records.find(r => r.id === id);
          if (!rec) return;
          editingId = id;
          editBuffer = { ...rec };
          renderTable();
          const dateInputEl = document.getElementById('edit-date');
          if (dateInputEl) dateInputEl.focus();
        } else if (action === 'cancel') {
          editingId = null;
          editBuffer = null;
          renderTable();
        } else if (action === 'save') {
          const dateVal = document.getElementById('edit-date')?.value;
          const startVal = document.getElementById('edit-start')?.value;
          const endVal = document.getElementById('edit-end')?.value;
          const dailyOvertimeVal = document.getElementById('edit-dailyOvertime')?.value;
          const isHolidayVal = document.getElementById('edit-isHoliday')?.checked || false;

          if (!dateVal || !startVal) {
            alert('日付、開始時間を入力してください');
            return;
          }

          const startStr = timeInputToFullStr(startVal);
          const endStr = endVal ? timeInputToFullStr(endVal) : '';

          const workHours = calcWorkHours(startStr, endStr);
          const overtime = calcOvertime(startStr, endStr, isHolidayVal);
          const newDailyOvertime = dailyOvertimeVal === '' ? null : parseFloat(dailyOvertimeVal);

          const updated = {
            ...records.find(r => r.id === id),
            date: dateVal,
            start: startStr,
            end: endStr,
            workHours: workHours,
            overtime: overtime,
            dailyOvertime: newDailyOvertime,
            isHoliday: isHolidayVal,
          };

          await saveRecord(updated);
          const idx = records.findIndex(r => r.id === id);
          if (idx !== -1) records[idx] = updated;

          editingId = null;
          editBuffer = null;

          const oldMonths = getAllMonths();
          populateMonthSelects();
          if (!oldMonths.includes(currentMonth)) {
            const newMonths = getAllMonths();
            currentMonth = newMonths.length > 0 ? newMonths[newMonths.length - 1] : '';
          }

          renderTable();
          renderChart();
          showSnackbar('レコードを更新しました');
        } else if (action === 'delete') {
          if (confirm('このレコードを削除しますか？')) {
            await deleteRecord(id);
            records = records.filter(r => r.id !== id);
            if (editingId === id) { editingId = null; editBuffer = null; }
            populateMonthSelects();
            renderTable();
            renderChart();
            showSnackbar('レコードを削除しました');
          }
        }
      }

      function updateSummary() {
        const filtered = getFilteredRecords();
        const totalWork = filtered.reduce((sum, r) => sum + calcWorkHours(r.start, r.end), 0);
        const totalOvertime = filtered.reduce((sum, r) => sum + calcOvertime(r.start, r.end, r.isHoliday), 0);
        const totalDailyOvertime = filtered.reduce((sum, r) => {
          if (r.dailyOvertime !== null && r.dailyOvertime !== undefined) return sum + r.dailyOvertime;
          return sum;
        }, 0);

        summaryRow.innerHTML = `
          <div class="summary-item">
            <span>労働合計: ${totalWork.toFixed(1)} h</span>
            <span>残業合計: ${totalOvertime.toFixed(1)} h</span>
            <span>日報残業合計: ${totalDailyOvertime.toFixed(1)} h</span>
          </div>
          <div style="font: var(--md-sys-typescale-label-medium); color: var(--md-sys-color-on-surface-variant);">${filtered.length} 件</div>
        `;
      }

      function renderChart() {
        let labels = [];
        let overtimeValues = [];
        let chartLabel = '';

        if (chartMode === 'month') {
          const filtered = records
            .map(r => ({ ...r }))
            .filter(r => r.date.startsWith(chartMonth))
            .sort((a, b) => new Date(a.date) - new Date(b.date));

          if (filtered.length === 0) {
            if (chartInstance) { chartInstance.destroy(); chartInstance = null; }
            const ctx = chartCanvas.getContext('2d');
            ctx.clearRect(0, 0, chartCanvas.width, chartCanvas.height);
          } else {
            labels = filtered.map(r => {
              const d = new Date(r.date);
              return `${d.getMonth() + 1}/${d.getDate()}`;
            });
            overtimeValues = filtered.map(r => calcOvertime(r.start, r.end, r.isHoliday));
            chartLabel = '残業時間 (h)';
          }
        } else {
          if (!chartMonth) return;
          const year = chartMonth.split('-')[0];
          const monthlyTotals = new Array(12).fill(0);
          
          records.forEach(r => {
            if (r.date.startsWith(year)) {
              const monthIndex = parseInt(r.date.slice(5, 7), 10) - 1;
              monthlyTotals[monthIndex] += calcOvertime(r.start, r.end, r.isHoliday);
            }
          });

          labels = Array.from({ length: 12 }, (_, i) => `${i + 1}月`);
          overtimeValues = monthlyTotals;
          chartLabel = `${year}年 月別残業合計 (h)`;
        }

        let targetYear = chartMonth ? chartMonth.split('-')[0] : new Date().getFullYear().toString();
        let yearTotal = 0;
        records.forEach(r => {
          if (r.date.startsWith(targetYear)) {
            yearTotal += calcOvertime(r.start, r.end, r.isHoliday);
          }
        });
        statYear.textContent = targetYear;
        yearlyTotalOvertime.textContent = yearTotal.toFixed(1);

        if (chartInstance) chartInstance.destroy();
        if (labels.length === 0) return;

        const ctx = chartCanvas.getContext('2d');

        const valueLabelPlugin = {
          id: 'valueLabel',
          afterDatasetsDraw(chart) {
            const { ctx } = chart;
            chart.data.datasets.forEach((dataset, datasetIndex) => {
              const meta = chart.getDatasetMeta(datasetIndex);
              if (!meta.hidden) {
                meta.data.forEach((element, index) => {
                  const value = dataset.data[index];
                  if (value === null || value === undefined) return;
                  if (chartMode === 'year' && value === 0) return;
                  
                  const text = value.toFixed(1);
                  const { x, y } = element.tooltipPosition();
                  ctx.save();
                  ctx.font = '600 11px Inter, sans-serif';
                  ctx.fillStyle = '#46464F';
                  ctx.textAlign = 'center';
                  ctx.textBaseline = 'bottom';
                  ctx.fillText(text, x, y - 10);
                  ctx.restore();
                });
              }
            });
          }
        };

        chartInstance = new Chart(ctx, {
          type: 'line',
          data: {
            labels: labels,
            datasets: [{
              label: chartLabel,
              data: overtimeValues,
              borderColor: '#4A6EA8',
              backgroundColor: 'rgba(74,110,168,0.12)',
              borderWidth: 2.5,
              pointBackgroundColor: '#FFFFFF',
              pointBorderColor: '#4A6EA8',
              pointBorderWidth: 2,
              pointRadius: 4,
              pointHoverRadius: 6,
              fill: true,
              tension: 0.2,
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            layout: { padding: { top: 20, bottom: 4, left: 4, right: 4 } },
            plugins: {
              legend: { display: false },
              tooltip: {
                backgroundColor: '#FFFFFF',
                titleColor: '#1C1B1F',
                bodyColor: '#1C1B1F',
                borderColor: '#C7C5D0',
                borderWidth: 1,
                padding: 12,
                boxPadding: 6,
                callbacks: { label: (context) => `${context.parsed.y.toFixed(1)} h` }
              }
            },
            scales: {
              x: { grid: { display: false }, ticks: { color: '#46464F', font: { size: 11, family: 'Inter' } } },
              y: {
                beginAtZero: true,
                grid: { color: 'rgba(199,197,208,0.4)' },
                ticks: { color: '#46464F', font: { family: 'Inter' }, callback: (val) => val + 'h' }
              }
            }
          },
          plugins: [valueLabelPlugin]
        });
      }

      async function addRecord() {
        const dateVal = inputDate.value;
        const startVal = inputStart.value;
        const endVal = inputEnd.value;
        const dailyOvertimeVal = inputDailyOvertime.value;
        const isHolidayVal = inputIsHoliday.checked || false;

        if (!dateVal || !startVal) {
          alert('日付、開始時間を入力してください');
          return;
        }

        const startStr = timeInputToFullStr(startVal);
        const endStr = endVal ? timeInputToFullStr(endVal) : '';

        const existing = records.find(r => r.date === dateVal);
        if (existing) {
          alert('同じ日付のレコードが既に存在します。編集または削除してから追加してください。');
          return;
        }

        const workHours = calcWorkHours(startStr, endStr);
        const overtime = calcOvertime(startStr, endStr, isHolidayVal);
        const dailyOvertime = dailyOvertimeVal === '' ? null : parseFloat(dailyOvertimeVal);

        const newRecord = {
          date: dateVal,
          start: startStr,
          end: endStr,
          dailyOvertime: dailyOvertime,
          workHours: workHours,
          overtime: overtime,
          isHoliday: isHolidayVal,
        };

        const newId = await saveRecord(newRecord);
        newRecord.id = newId;
        records.push(newRecord);

        const monthsBefore = getAllMonths();
        populateMonthSelects();

        const newMonth = dateVal.slice(0, 7);
        if (!monthsBefore.includes(newMonth)) {
          currentMonth = newMonth;
          chartMonth = newMonth;
        }
        if (!monthsBefore.includes(currentMonth)) currentMonth = newMonth;
        if (!monthsBefore.includes(chartMonth)) chartMonth = newMonth;

        populateMonthSelects();
        renderTable();
        renderChart();

        // 清空表单
        inputStart.value = '08:30:00';
        inputEnd.value = ''; 
        inputDailyOvertime.value = '';
        inputIsHoliday.checked = false;
        const today = new Date();
        inputDate.value = formatDateToYMD(today);

        // 【新功能】添加成功后自动跳转到考勤一览页面
        const navDashboard = document.querySelector('.nav-item[data-view="dashboard"]');
        if (navDashboard) {
          navDashboard.click();
        }

        showSnackbar('勤怠記録を追加しました');
      }

      function exportData() {
        const exportData = records.map(({ id, ...rest }) => rest);
        const dataStr = JSON.stringify(exportData, null, 2);
        const blob = new Blob([dataStr], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `attendance_${new Date().toISOString().slice(0, 10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
      }

      function importData(file) {
        const reader = new FileReader();
        reader.onload = async (e) => {
          try {
            const imported = JSON.parse(e.target.result);
            if (Array.isArray(imported)) {
              const validRecords = imported.filter(r => r.date && r.start);
              if (validRecords.length === 0) { alert('有効なデータがありません。'); return; }

              const processed = validRecords.map(r => {
                const startStr = normalizeTimeInput(r.start);
                const endStr = r.end ? normalizeTimeInput(r.end) : '';
                const isHoliday = !!r.isHoliday;
                return {
                  date: r.date,
                  start: startStr,
                  end: endStr,
                  dailyOvertime: r.dailyOvertime !== undefined ? r.dailyOvertime : null,
                  workHours: calcWorkHours(startStr, endStr),
                  overtime: calcOvertime(startStr, endStr, isHoliday),
                  isHoliday: isHoliday,
                };
              });

              await bulkSaveRecords(processed);
              records = await loadAllRecords();

              const months = getAllMonths();
              if (months.length > 0) {
                currentMonth = months[months.length - 1];
                chartMonth = months[months.length - 1];
              } else {
                currentMonth = '';
                chartMonth = '';
              }

              populateMonthSelects();
              renderTable();
              renderChart();
              showSnackbar('インポートが完了しました');
            } else {
              alert('無効なファイル形式です。');
            }
          } catch (err) {
            alert('ファイルの読み込みに失敗しました。');
            console.error(err);
          }
        };
        reader.readAsText(file);
      }

      async function resetAllData() {
        if (!confirm('すべての勤怠データを削除します。この操作は取り消せません。よろしいですか？')) return;
        await clearAllRecords();
        records = [];
        currentMonth = getCurrentYearMonth();
        chartMonth = currentMonth;
        populateMonthSelects();
        renderTable();
        renderChart();
        showSnackbar('データを初期化しました');
      }

      function switchView(viewId) {
        viewSections.forEach(s => s.classList.remove('active'));
        const targetView = document.getElementById('view-' + viewId);
        if (targetView) targetView.classList.add('active');

        if (viewId === 'chart') {
          if (!chartMonth) {
            const months = getAllMonths();
            chartMonth = months.length > 0 ? months[months.length - 1] : '';
          }
          renderChart();
        }
        if (viewId === 'dashboard') {
          editingId = null;
          editBuffer = null;
          renderTable();
        }
      }

      function bindEvents() {
        monthSelect.addEventListener('change', (e) => {
          currentMonth = e.target.value;
          editingId = null;
          editBuffer = null;
          renderTable();
        });

        chartMonthSelect.addEventListener('change', (e) => {
          chartMonth = e.target.value;
          renderChart();
        });

        toggleBtns.forEach(btn => {
          btn.addEventListener('click', (e) => {
            toggleBtns.forEach(b => b.classList.remove('active'));
            e.target.classList.add('active');
            
            chartMode = e.target.getAttribute('data-chart-mode');
            
            if (chartMode === 'year') {
              chartMonthFilter.style.display = 'none';
            } else {
              chartMonthFilter.style.display = 'flex';
            }
            
            renderChart();
          });
        });

        addRecordBtn.addEventListener('click', addRecord);

        importBtn.addEventListener('click', () => importFileInput.click());
        importFileInput.addEventListener('change', (e) => {
          if (e.target.files.length > 0) {
            importData(e.target.files[0]);
            importFileInput.value = '';
          }
        });
        exportBtn.addEventListener('click', exportData);
        resetBtn.addEventListener('click', resetAllData);

        const today = new Date();
        inputDate.value = formatDateToYMD(today);
        inputEnd.value = '';
      }

      async function init() {
        try {
          await openDB();
          records = await loadAllRecords();

          initDefaultMonth();
          populateMonthSelects();
          bindEvents();
          renderTable();
          renderChart();
          loadingOverlay.classList.add('hidden');
        } catch (err) {
          console.error('初期化エラー:', err);
          loadingOverlay.textContent = 'データの読み込みに失敗しました。';
        }
      }

      init();
    })();
  </script>
</body>
</html>
